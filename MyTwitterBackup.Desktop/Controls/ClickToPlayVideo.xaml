<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MyTwitterBackup.Desktop.Controls.ClickToPlayVideo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.HelpText="Click or press Space to play or pause"
    IsTabStop="True"
    KeyDown="OnKeyDown"
    Loaded="OnLoaded"
    Tapped="OnTapped"
    Unloaded="OnUnloaded"
    UseSystemFocusVisuals="True">

    <UserControl.Resources>
        <Style x:Key="OverlayIconBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="72" />
            <Setter Property="CornerRadius" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!--  The icon pops up in the center, grows and fades out.  -->
        <Storyboard x:Name="FlashStoryboard" Completed="FlashStoryboard_Completed">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FlashIcon" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation
                Storyboard.TargetName="FlashScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.8"
                To="1.4"
                Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="FlashScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.8"
                To="1.4"
                Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <!--  Transparent background so clicks anywhere on the video are received.  -->
    <Grid Background="Transparent">
        <MediaPlayerElement
            x:Name="Player"
            AreTransportControlsEnabled="False"
            IsHitTestVisible="False"
            Stretch="Uniform" />

        <!--  Shown while the video is paused or has not started.  -->
        <Border
            x:Name="PlayHint"
            Style="{StaticResource OverlayIconBorderStyle}"
            Visibility="Collapsed">
            <FontIcon
                FontSize="32"
                Foreground="White"
                Glyph="&#xE768;" />
        </Border>

        <Border
            x:Name="FlashIcon"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5"
            Style="{StaticResource OverlayIconBorderStyle}">
            <Border.RenderTransform>
                <ScaleTransform x:Name="FlashScale" />
            </Border.RenderTransform>
            <FontIcon
                x:Name="FlashGlyph"
                FontSize="32"
                Foreground="White"
                Glyph="&#xE768;" />
        </Border>
    </Grid>
</UserControl>
