<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyTwitterBackup.Desktop.Views.BrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MyTwitterBackup.Desktop.Helpers"
    xmlns:vm="using:MyTwitterBackup.Desktop.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!--  Browser  -->
        <Grid Padding="8,0,4,8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackButton"
                    AutomationProperties.AutomationId="BrowserBackButton"
                    AutomationProperties.Name="Back"
                    Click="BackButton_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Back">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <Button
                    x:Name="ForwardButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="BrowserForwardButton"
                    AutomationProperties.Name="Forward"
                    Click="ForwardButton_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Forward">
                    <FontIcon FontSize="14" Glyph="&#xE72A;" />
                </Button>
                <Button
                    Grid.Column="2"
                    AutomationProperties.AutomationId="BrowserReloadButton"
                    AutomationProperties.Name="Reload"
                    Click="ReloadButton_Click"
                    ToolTipService.ToolTip="Reload">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
                <Button
                    Grid.Column="3"
                    AutomationProperties.AutomationId="BrowserHomeButton"
                    AutomationProperties.Name="Home"
                    Click="HomeButton_Click"
                    ToolTipService.ToolTip="x.com/home">
                    <FontIcon FontSize="14" Glyph="&#xE80F;" />
                </Button>
                <AutoSuggestBox
                    x:Name="AddressBox"
                    Grid.Column="4"
                    AutomationProperties.AutomationId="BrowserAddressBox"
                    AutomationProperties.Name="Address"
                    PlaceholderText="https://x.com/i/bookmarks"
                    QueryIcon="Forward"
                    QuerySubmitted="AddressBox_QuerySubmitted"
                    Text="{x:Bind ViewModel.CurrentUrl, Mode=OneWay}" />
            </Grid>

            <InfoBar
                x:Name="WebViewErrorBar"
                Grid.Row="1"
                AutomationProperties.AutomationId="WebViewErrorInfoBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error"
                Title="Browser not available" />

            <Border
                Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <WebView2 x:Name="WebView" AutomationProperties.AutomationId="BrowserWebView" />
            </Border>
        </Grid>

        <!--  Download panel  -->
        <Grid
            Grid.Column="1"
            Padding="8,0,12,8"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Top"
                        FontSize="24"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="{x:Bind ViewModel.ModeGlyph, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Detected mode" />
                        <TextBlock
                            AutomationProperties.AutomationId="DetectedModeText"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.ModeTitle, Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.ModeDescription, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Spacing="8">
                <Button
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="DownloadButton"
                    AutomationProperties.Name="Download"
                    Command="{x:Bind ViewModel.DownloadCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE896;" />
                        <TextBlock Text="Download" />
                    </StackPanel>
                </Button>
                <Grid>
                    <TextBlock AutomationProperties.AutomationId="DetectedCountText" Style="{StaticResource BodyStrongTextBlockStyle}">
                        <Run Text="{x:Bind ViewModel.DetectedCount, Mode=OneWay}" />
                        <Run Text="detected" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}">
                        <Run Text="{x:Bind ViewModel.WithDataCount, Mode=OneWay}" />
                        <Run Text="with data," />
                        <Run Text="{x:Bind ViewModel.NotQueuedCount, Mode=OneWay}" />
                        <Run Text="not queued" />
                    </TextBlock>
                </Grid>
            </StackPanel>

            <InfoBar
                Grid.Row="2"
                AutomationProperties.AutomationId="BrowserStatusInfoBar"
                IsOpen="{x:Bind helpers:XamlHelpers.HasText(ViewModel.StatusMessage), Mode=OneWay}"
                IsClosable="False"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Informational" />

            <Border
                Grid.Row="3"
                Style="{StaticResource CardBorderStyle}"
                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.IsResolving), Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.ResolveProgressText, Mode=OneWay}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" />
                    <Button
                        AutomationProperties.AutomationId="CancelResolveButton"
                        Command="{x:Bind ViewModel.CancelResolveCommand}"
                        Content="Cancel" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Detected posts" />
                    <HyperlinkButton
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="ClearDetectedButton"
                        Command="{x:Bind ViewModel.ClearDetectedCommand}"
                        Content="Clear" />
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="No posts detected on this page yet."
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:XamlHelpers.ZeroToVisibility(ViewModel.DetectedCount), Mode=OneWay}" />
                <ListView
                    Grid.Row="1"
                    AutomationProperties.AutomationId="DetectedPostsList"
                    ItemsSource="{x:Bind ViewModel.DetectedPosts, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetectedPostViewModel">
                            <Grid Padding="0,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Margin="0,2,0,0"
                                    VerticalAlignment="Top"
                                    FontSize="14"
                                    Glyph="&#xE73E;"
                                    ToolTipService.ToolTip="{x:Bind DataStatusText, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(HasData), Mode=OneWay}" />
                                <FontIcon
                                    Margin="0,2,0,0"
                                    VerticalAlignment="Top"
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE9CE;"
                                    ToolTipService.ToolTip="{x:Bind DataStatusText, Mode=OneWay}"
                                    Visibility="{x:Bind helpers:XamlHelpers.InvertBoolToVisibility(HasData), Mode=OneWay}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        MaxLines="2"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="{x:Bind Snippet, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Queued"
                                        Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(IsQueued), Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
