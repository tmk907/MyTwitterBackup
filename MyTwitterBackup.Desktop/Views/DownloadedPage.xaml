<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyTwitterBackup.Desktop.Views.DownloadedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MyTwitterBackup.Desktop.Helpers"
    x:DefaultBindMode="OneTime"
    xmlns:vm="using:MyTwitterBackup.Desktop.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="PhotoTemplate" x:DataType="vm:MediaItemViewModel">
            <StackPanel Margin="0,0,0,12" Spacing="4">
                <Border
                    HorizontalAlignment="Left"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Image
                        MaxHeight="520"
                        AutomationProperties.Name="{x:Bind Description}"
                        Source="{x:Bind Image}"
                        Stretch="Uniform" />
                </Border>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Description}" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="File not found"
                    Visibility="{x:Bind helpers:XamlHelpers.InvertBoolToVisibility(FileExists)}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="VideoTemplate" x:DataType="vm:MediaItemViewModel">
            <StackPanel Margin="0,0,0,12" Spacing="4">
                <MediaPlayerElement
                    Height="400"
                    HorizontalAlignment="Stretch"
                    AreTransportControlsEnabled="True"
                    AutoPlay="False"
                    AutomationProperties.Name="{x:Bind Description}"
                    PosterSource="{x:Bind Poster}"
                    Source="{x:Bind MediaSource}"
                    Unloaded="MediaPlayerElement_Unloaded" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Description}" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="File not found"
                    Visibility="{x:Bind helpers:XamlHelpers.InvertBoolToVisibility(FileExists)}" />
            </StackPanel>
        </DataTemplate>

        <helpers:MediaTemplateSelector
            x:Key="MediaSelector"
            PhotoTemplate="{StaticResource PhotoTemplate}"
            VideoTemplate="{StaticResource VideoTemplate}" />

        <DataTemplate x:Key="MetadataTemplate" x:DataType="vm:MetadataEntry">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Label}" />
                <TextBlock
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Value}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PostDetailTemplate" x:DataType="vm:PostDetailViewModel">
            <StackPanel Spacing="16">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind DisplayName}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}">
                            <Run Text="{x:Bind UserName}" />
                            <Run Text="-" />
                            <Run Text="{x:Bind CreatedText}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="4">
                        <HyperlinkButton
                            AutomationProperties.AutomationId="OpenOriginalPostLink"
                            Content="Open on x.com"
                            NavigateUri="{x:Bind PostUri}" />
                        <Button
                            AutomationProperties.AutomationId="OpenPostFolderButton"
                            Command="{x:Bind OpenFolderCommand}"
                            Content="Open folder" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />

                <ItemsControl
                    ItemTemplateSelector="{StaticResource MediaSelector}"
                    ItemsSource="{x:Bind Media}"
                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(HasMedia)}" />

                <!--  Quoted post  -->
                <Border
                    Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(HasQuoted)}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Quoted post" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                            <Run Text="{x:Bind Quoted.DisplayName}" />
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Quoted.UserName}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Quoted.CreatedText}" />
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Quoted.Text}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemTemplateSelector="{StaticResource MediaSelector}" ItemsSource="{x:Bind Quoted.Media}" />
                        <HyperlinkButton Content="Open quoted post on x.com" NavigateUri="{x:Bind Quoted.PostUri}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Metadata" />
                        <ItemsControl ItemTemplate="{StaticResource MetadataTemplate}" ItemsSource="{x:Bind Metadata}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,8,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Downloaded" />
            <Button
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="RefreshDownloadedButton"
                AutomationProperties.Name="Refresh"
                Command="{x:Bind ViewModel.LoadCommand}"
                ToolTipService.ToolTip="Refresh">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <SelectorBar
            x:Name="SourceSelector"
            Grid.Row="1"
            SelectionChanged="SourceSelector_SelectionChanged">
            <SelectorBarItem
                AutomationProperties.AutomationId="TabBookmarks"
                IsSelected="True"
                Tag="Bookmark"
                Text="Bookmarks" />
            <SelectorBarItem
                AutomationProperties.AutomationId="TabLiked"
                Tag="Like"
                Text="Liked" />
            <SelectorBarItem
                AutomationProperties.AutomationId="TabOther"
                Tag="Single"
                Text="Other" />
        </SelectorBar>

        <InfoBar
            Grid.Row="2"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="DownloadedErrorInfoBar"
            IsOpen="{x:Bind helpers:XamlHelpers.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
            IsClosable="False"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Post list  -->
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox
                    AutomationProperties.AutomationId="DownloadedFilterBox"
                    AutomationProperties.Name="Filter posts"
                    PlaceholderText="Filter by text or author"
                    Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Grid.Row="1"
                    AutomationProperties.AutomationId="DownloadedCountText"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="No downloaded posts in this category yet."
                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}" />
                <ListView
                    Grid.Row="2"
                    AutomationProperties.AutomationId="DownloadedPostsList"
                    ItemsSource="{x:Bind ViewModel.Posts}"
                    SelectedItem="{x:Bind ViewModel.SelectedPost, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PostListItem">
                            <StackPanel Padding="0,8" Spacing="2">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Author}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="{x:Bind DateText}" />
                                </Grid>
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind Snippet}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!--  Preview  -->
            <Border
                Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="Select a post to preview it."
                        Visibility="{x:Bind helpers:XamlHelpers.NullToVisibility(ViewModel.Detail), Mode=OneWay}" />
                    <ScrollViewer Padding="24,16">
                        <ContentControl
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="PostPreview"
                            Content="{x:Bind ViewModel.Detail, Mode=OneWay}"
                            ContentTemplate="{StaticResource PostDetailTemplate}"
                            IsTabStop="False" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
