<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MyTwitterBackup.Desktop.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:MyTwitterBackup.Desktop.Helpers"
    x:DefaultBindMode="OneTime"
    xmlns:vm="using:MyTwitterBackup.Desktop.ViewModels">

    <Grid Padding="24,8,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Download queue" />
                <TextBlock
                    AutomationProperties.AutomationId="QueueStateText"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
            </StackPanel>
            <CommandBar
                HorizontalAlignment="Right"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton
                    AutomationProperties.AutomationId="PauseResumeButton"
                    Command="{x:Bind ViewModel.PauseResumeCommand}"
                    Label="{x:Bind ViewModel.PauseResumeLabel, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="{x:Bind ViewModel.PauseResumeGlyph, Mode=OneWay}" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    AutomationProperties.AutomationId="RetryFailedButton"
                    Command="{x:Bind ViewModel.RetryFailedCommand}"
                    Label="Retry failed">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    AutomationProperties.AutomationId="FetchMissingDataButton"
                    Command="{x:Bind ViewModel.FetchMissingDataCommand}"
                    Label="Fetch missing data"
                    ToolTipService.ToolTip="Opens each post without captured data in the browser to capture it">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton
                        AutomationProperties.AutomationId="ClearCompletedButton"
                        Command="{x:Bind ViewModel.ClearCompletedCommand}"
                        Label="Clear completed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE73E;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        AutomationProperties.AutomationId="ClearQueueButton"
                        Click="ClearQueueButton_Click"
                        Label="Clear entire queue">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="24">
            <TextBlock AutomationProperties.AutomationId="QueuePendingCount">
                <Run Text="Pending" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.Counts.Pending, Mode=OneWay, FallbackValue=0}" />
            </TextBlock>
            <TextBlock>
                <Run Text="Downloading" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.Counts.Downloading, Mode=OneWay, FallbackValue=0}" />
            </TextBlock>
            <TextBlock AutomationProperties.AutomationId="QueueCompletedCount">
                <Run Text="Completed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.Counts.Completed, Mode=OneWay, FallbackValue=0}" />
            </TextBlock>
            <TextBlock AutomationProperties.AutomationId="QueueFailedCount">
                <Run Text="Failed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.Counts.Failed, Mode=OneWay, FallbackValue=0}" />
            </TextBlock>
            <TextBlock AutomationProperties.AutomationId="QueueMissingCount">
                <Run Text="Missing data" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.Counts.MissingData, Mode=OneWay, FallbackValue=0}" />
            </TextBlock>
        </StackPanel>

        <InfoBar
            Grid.Row="2"
            AutomationProperties.AutomationId="QueueStatusInfoBar"
            IsOpen="{x:Bind helpers:XamlHelpers.HasText(ViewModel.StatusMessage), Mode=OneWay}"
            IsClosable="False"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="Informational" />

        <StackPanel
            Grid.Row="3"
            Margin="0,48,0,0"
            HorizontalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE896;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="The queue is empty" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Open a post, bookmarks or likes in the Browser and click Download." />
        </StackPanel>

        <ListView
            Grid.Row="3"
            AutomationProperties.AutomationId="QueueList"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:QueueItemViewModel">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Top"
                            FontSize="16"
                            Glyph="{x:Bind StatusGlyph, Mode=OneWay}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="{x:Bind PreviewText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind helpers:XamlHelpers.StringToVisibility(PreviewText), Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Error, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:XamlHelpers.StringToVisibility(Error), Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind SourceText}" />
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Top"
                            Text="{x:Bind StatusText, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
